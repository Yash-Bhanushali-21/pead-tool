# Copy to .env and fill in values:  cp .env.sample .env
# Loaded automatically by src/config/config.py (python-dotenv).

# --- Required for chat agent + optional LLM news / technical verdict ---
OPENAI_API_KEY=

# --- API server (FastAPI) ---
# Comma-separated browser origins allowed to call the API (dev UI proxies /api)
PEAD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- OpenAI model IDs (override defaults in code) ---
OPENAI_NEWS_MODEL=gpt-4o-mini
OPENAI_TECH_VERDICT_MODEL=gpt-4o-mini
AGENT_MODEL=openai:gpt-4o-mini
AGENT_SYNTHESIS_MODEL=openai:gpt-4o-mini

# --- News RSS scan defaults ---
NEWS_LOOKBACK_DAYS=90
NEWS_MAX_ARTICLES=80

# --- Market / PEAD (optional overrides) ---
ESTIMATION_WINDOW=120
MARKET_INDEX=^NSEI
# Comma-separated trading-day windows for CARs
CAR_WINDOWS=1,10,30,60,90
SIGNIFICANCE_LEVEL=0.05
TOP_N_COMPANIES=10
MIN_TRADING_DAYS=80

# --- Paths ---
PDF_DOWNLOAD_DIR=./data/announcements
CACHE_DIR=./data/cache
AGENT_OUTPUT_SUBDIR=agent_runs

# --- Chat persistence (SQLite) ---
CHAT_SQLITE_PATH=./data/pead_chat.sqlite3
# CHAT_PERSIST_ENABLED=true

# --- Scoring / screens (optional) ---
VOLUME_SPIKE_THRESHOLD=2.0
VOLUME_LOOKBACK=20
CFO_QUALITY_THRESHOLD=1.0
MARGIN_EXPANSION_THRESHOLD=0.02
DRIFT_SHORT_WINDOW=5
DRIFT_MEDIUM_WINDOW=10
DRIFT_LONG_WINDOW=30

# --- Composite scoring weights (optional; must sum sensibly with your code) ---
# SCORING_EARNINGS_SURPRISE=0.25
# SCORING_PRICE_REACTION=0.20
# SCORING_DRIFT_CONFIRMATION=0.25
# SCORING_EARNINGS_QUALITY=0.15
# SCORING_CONTEXTUAL=0.15
